{
  "_help": "Шаблоны документов АкБарак. Поля в тексте: {ключ}. Пол: {sex:вариант для м|вариант для ж}. Выравнивание a: c — центр, j — по ширине, hdr — шапка справа. opt: строка пропускается, если поле в ней пустое. type sign — дата слева, подпись справа. type logo — эмблема КГМА (файл icons/kgma.png; нет файла — блок пропускается), h — высота в пунктах. a l — по левому краю. label — жирная подпись перед текстом. pos bottom — строка внизу листа.",
  "fields": {
    "sex": {"label": "Пол", "type": "select", "options": [["m", "Мужской"], ["f", "Женский"]], "def": "m"},
    "fio_nom": {"label": "ФИО полностью", "ph": "Асанов Бекжан Маратович", "save": true},
    "fio_gen": {"label": "ФИО — от кого (родительный падеж)", "ph": "Асанова Бекжана Маратовича", "save": true},
    "fio_short": {"label": "Фамилия и инициалы для подписи", "ph": "Асанов Б.М.", "save": true},
    "course": {"label": "Курс", "ph": "5", "save": true, "max": 2},
    "group": {"label": "Группа", "ph": "37 ЛД-2", "save": true, "max": 20},
    "faculty": {"label": "Факультет (какого)", "ph": "лечебного", "save": true},
    "phone": {"label": "Телефон", "ph": "0700 123 456", "save": true, "optional": true, "max": 20},
    "date": {"label": "Дата", "ph": "25.10.2026", "auto": "date", "max": 12},
    "year": {"label": "Год", "ph": "2026", "auto": "year", "max": 4},
    "chair_pos": {"label": "Кому (должность, в дательном падеже)", "ph": "Заведующему кафедрой факультетской терапии"},
    "chair_name": {"label": "ФИО заведующего (кому)", "ph": "проф. Иванову И.И.", "optional": true},
    "dean_name": {"label": "ФИО декана (кому)", "ph": "Иванову И.И.", "optional": true},
    "subject": {"label": "Дисциплина", "ph": "Факультетская терапия"},
    "dates": {"label": "Даты занятий", "ph": "12.10.2026 и 14.10.2026"},
    "reason": {"label": "Причина", "ph": "болезнью (справка прилагается)"},
    "reason_obj": {"label": "Причина отсутствия", "ph": "болезнь, справка прилагается"},
    "exam_type": {"label": "Что пересдать", "type": "select", "options": [["экзамена", "Экзамен"], ["зачёта", "Зачёт"], ["модуля", "Модуль"]], "def": "экзамена"},
    "where": {"label": "Куда нужна справка", "ph": "в Социальный фонд"},
    "dept": {"label": "Кафедра (какая)", "ph": "нормальной анатомии"},
