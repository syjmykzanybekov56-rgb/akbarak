    "topic": {"label": "Тема", "ph": "Анатомия и физиология сердца", "max": 160},
    "teacher": {"label": "Преподаватель (кто проверил)", "ph": "доц. Иванова А.А.", "optional": true},
    "head": {"label": "Заведующий кафедрой", "ph": "проф. Иванов И.И.", "optional": true},
